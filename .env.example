# Copy to Netlify environment variables / GitHub Actions secrets.
# LinkedIn does not expose a public personal-posts API, so automation uses an RSS bridge.

# 1) Create a free LinkedIn activity RSS feed at rss.app or fetchrss.com
#    for https://www.linkedin.com/in/hitesh-dodiya1/
# 2) Paste the feed URL below (Netlify + GitHub Actions secret of the same name)
LINKEDIN_RSS_FEED_URL=

# Existing CRA flags
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=true
